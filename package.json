{
  "name": "newvexorion",
  "version": "2.1.0",
  "description": "Data processing library for Vexorion member data with Express backend, WebSocket, and PM2 support",
  "author": "Prasetyo Bayu Widodo",
  "type": "module",
  "main": "src/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/dheasrafa-droid/NewVexorion"
  },
  "homepage": "https://new-vexorion-git-main-ercs-projects-09b1de49.vercel.app/",
  "scripts": {
    "start": "node server.js",
    "start:dev": "nodemon server.js",
    "start:pm2": "pm2 start server.js --name newvexorion",
    "stop:pm2": "pm2 stop newvexorion",
    "restart:pm2": "pm2 restart newvexorion",
    "logs:pm2": "pm2 logs newvexorion",
    "status:pm2": "pm2 status",
    "monit:pm2": "pm2 monit",
    "start:basic": "node example/run.js",
    "start:full": "node example/run-full.js",
    "start:enhanced": "node example/run-enhanced.js",
    "start:assets": "node example/run-assets.js",
    "start:attributes": "node example/run-attributes.js",
    "test": "node test/test.js",
    "test:full": "node test/test-full.js",
    "test:watch": "nodemon test/test-full.js",
    "web": "cd web && npx live-server --port=8080",
    "web:enhanced": "cd web && npx live-server --port=8081 index-enhanced.html",
    "lint": "eslint src/**/*.js server.js",
    "format": "prettier --write src/**/*.js server.js",
    "build": "vite build && npm run test:full",
    "docker:build": "docker build -t newvexorion .",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up",
    "clean": "rm -rf output/* logs/* test/*.txt test/*.log",
    "dev": "vite --port=3000 --host=0.0.0.0"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "morgan": "^1.12.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "eslint": "^8.40.0",
    "nodemon": "^3.1.14",
    "pm2": "^7.0.4",
    "prettier": "^2.8.8",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
